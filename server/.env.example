# Server Configuration
PORT=3001
CORS_ORIGIN=*

# Institutional Faculty Moderation Passphrase (used to unlock moderation controls)
FACULTY_PASSPHRASE=faculty123

# Optional: Redis Cloud / Redis Sentinel URL for distributed room scaling (leave empty for in-memory store)
REDIS_URL=

# Nebius DeepSeek-V4 AI Integration
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Resend Email Integration (for OTP & Notes Delivery)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=iChatWorld <onboarding@resend.dev>
