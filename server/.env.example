# Server Configuration
PORT=3001
CORS_ORIGIN=*

# Institutional Faculty Moderation Passphrase (used to unlock moderation controls)
FACULTY_PASSPHRASE=faculty123

# Optional: Redis Cloud / Redis Sentinel URL for distributed room scaling (leave empty for in-memory store)
