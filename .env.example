# iChatWorld Environment Variables Example

# Backend Server (server/.env)
PORT=3001
CORS_ORIGIN=*
FACULTY_PASSPHRASE=faculty123
REDIS_URL=
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Frontend Client (client/.env)
# Set to your deployed backend URL on Render/Railway/Fly.io if deploying frontend to Netlify:
VITE_BACKEND_URL=
